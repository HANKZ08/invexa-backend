# Copia este archivo como .env y ajusta los valores.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=invexa
DB_USER=postgres
DB_PASSWORD=tu-contraseña-de-postgres
DB_HOST=localhost
DB_PORT=5432

# Origen del frontend (Vite usa el puerto 5173 por defecto)
CORS_ALLOWED_ORIGINS=http://localhost:5173

TIME_ZONE=America/Lima
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Reglas de negocio
INVEXA_TAX_RATE=0.18
INVEXA_BUSINESS_NAME=Ferretería El Tornillo

# Seguridad
LOGIN_THROTTLE_RATE=10/min
# Solo aplican con DEBUG=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=2592000
SECURE_HSTS_PRELOAD=False

# Correo: Gmail con contraseña de aplicación (sin credenciales se imprime en consola)
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicación
INVEXA_VERIFICATION_CODE_MINUTES=10
EMAIL_VERIFICATION_THROTTLE_RATE=10/min
